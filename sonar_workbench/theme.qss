QMainWindow { background: #eef3f7; }
QWidget { font-family: "Microsoft YaHei UI", "Microsoft YaHei"; font-size: 10pt; color: #213044; }
QWidget#centralwidget { background: #eef3f7; }
QLabel#brandTitle { font-size: 20pt; font-weight: 700; color: #142d43; }
QLabel#brandSubtitle, QLabel#sourceLabel { color: #62748a; font-size: 9pt; }
QLabel#imageLabel { background: #091923; border: 1px solid #183a4d; border-radius: 10px; color: #83a1b5; }
QFrame#playbackCard { background: white; border: 1px solid #dce5ec; border-radius: 9px; }
QDockWidget { font-weight: 600; }
QDockWidget::title { background: #dae6ed; padding: 8px 12px; border-bottom: 1px solid #c7d6e1; }
QWidget#behaviorContent, QWidget#controlContent, QWidget#logContent { background: white; }
QLabel#behaviorState { font-size: 25pt; font-weight: 700; color: #64748b; padding: 10px; }
QLabel#behaviorState[state="normal"] { color: #117c67; background: #e7f5ef; border-radius: 8px; }
QLabel#behaviorState[state="feeding"] { color: #b65b13; background: #fff1dc; border-radius: 8px; }
QLabel#phaseLabel, QLabel#contractLabel, QLabel#sourceCaution, QLabel#layoutHint { color: #62748a; font-size: 9pt; }
QLabel#sourceCaution { color: #956717; background: #fff7e7; border-radius: 6px; padding: 8px; }
QPushButton { background: white; border: 1px solid #c9d8e2; border-radius: 6px; padding: 6px 10px; min-height: 22px; }
QPushButton:hover { background: #edf7f8; border-color: #73b5bd; }
QPushButton:pressed { background: #d8eef0; }
QPushButton:disabled { color: #97a6b4; background: #f0f4f7; }
QPushButton#openDbButton, QPushButton#playButton { background: #137d88; color: white; border-color: #137d88; font-weight: 600; }
QPushButton#openDbButton:hover, QPushButton#playButton:hover { background: #096a76; }
QCheckBox { spacing: 7px; padding: 3px; }
QSpinBox, QDoubleSpinBox, QComboBox { background: white; border: 1px solid #c9d8e2; border-radius: 5px; padding: 5px; }
QProgressBar { border: 1px solid #dce5ec; border-radius: 4px; background: #eef3f7; text-align: center; min-height: 22px; }
QProgressBar::chunk { background: #42a6af; border-radius: 3px; }
QSlider::groove:horizontal { height: 5px; background: #cedce5; border-radius: 2px; }
QSlider::handle:horizontal { width: 14px; margin: -5px 0; background: #137d88; border-radius: 7px; }
QPlainTextEdit { background: #f8fafc; border: 1px solid #e0e8ef; border-radius: 5px; font-family: Consolas, "Microsoft YaHei"; font-size: 9pt; }
QTableWidget { background: white; alternate-background-color: #f3f7fa; gridline-color: #e3ebf1; border: 1px solid #dce5ec; }
QHeaderView::section { background: #f0f5f8; border: 0; border-bottom: 1px solid #dce5ec; padding: 6px; font-weight: 600; }
QStatusBar { background: #e4edf3; color: #586c80; }
QMenuBar, QMenu { background: white; }
QMenuBar::item:selected, QMenu::item:selected { background: #e2f1f3; }

